{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path((?!assets/).*)", "destination": "/admin/index.html" },
    { "source": "/((?!v1/|admin(?:/|$)|api/|health|assets/).*)", "destination": "/index.html" }
  ]
}
